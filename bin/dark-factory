#!/usr/bin/env bash
# Dark Factory CLI — installed binary wrapper (not python -m runner from source).
#
# Resolves pipelines/prompts from DARK_FACTORY_HOME; implements in --workdir (default: cwd).

set -euo pipefail

# Capture original CLI arguments before trap overwrites $@
_ORIGINAL_ARGV=("$@")

# ---------------------------------------------------------------------------
# Top-level panic hook — writes a crash artifact on any non-zero exit
# (bash-level or Python-level). Exit code 124 is preserved as the
# distinct panic sentinel so CI / the Healer can group panics
# separately from regular failures.
#
# Use a guard variable (__DF_PANIC_FIRED) so the trap runs at most
# once even when both ERR and EXIT fire for the same failure, and
# do NOT use ``exec`` for the Python subprocess so the bash shell
# stays alive to actually run the EXIT trap on Python's exit code.
# ---------------------------------------------------------------------------
__df_panic_fired=0
__df_panic_collect() {
  local rc="$1" line="$2"
  if [[ "${rc}" -ne 0 && "${__df_panic_fired}" -eq 0 && -n "${VENV_PYTHON:-}" && -x "${VENV_PYTHON}" ]]; then
    __df_panic_fired=1
    # Best-effort: never let the panic hook itself cause a second
    # failure. Pass the wrapper name + original argv as a single
    # JSON-encoded string so argparse can't greedily misread it.
    local argv_json
    argv_json="$(printf '%s\0' "$0" "${_ORIGINAL_ARGV[@]}" | python3 -c 'import json,sys;data=sys.stdin.buffer.read().split(b"\x00");data=[x.decode("utf-8","replace") for x in data if x];print(json.dumps(data))' 2>/dev/null || printf '[]')"
    env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
      "${VENV_PYTHON}" -m runner.panic_hook \
      --exit-code "${rc}" \
      --line "${line}" \
      --bash-argv "${argv_json}" >/dev/null 2>&1 || true
  fi
  exit "${rc}"
}
# merge_train release runs in the EXIT trap AFTER any panic-hook work
# so the lock is always released (success or error). It is a no-op
# when no lock was acquired (idempotent on the Python side). The
# release command is built lazily by __df_release_lock so the trap
# string itself stays static.
__df_release_lock() {
  if [[ -n "${__DF_LOCK_RUN_ID:-}" && -n "${__DF_LOCK_TARGET:-}" && -n "${VENV_PYTHON:-}" && -x "${VENV_PYTHON}" ]]; then
    env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
      "${VENV_PYTHON}" -m runner._merge_train release \
      --target "${__DF_LOCK_TARGET}" --run-id "${__DF_LOCK_RUN_ID}" \
      >/dev/null 2>&1 || true
  fi
}
trap '__df_exit_code=$?; __df_release_lock; __df_panic_collect ${__df_exit_code} $LINENO' EXIT

_SCRIPT_REAL="$([ -L "${BASH_SOURCE[0]}" ] && readlink -f "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${_SCRIPT_REAL}")" && pwd)"
export DARK_FACTORY_HOME="${DARK_FACTORY_HOME:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
VENV_PYTHON="${DARK_FACTORY_HOME}/.venv/bin/python"
TARGET_WORKDIR="$(pwd)"

if [[ ! -x "${VENV_PYTHON}" ]]; then
  echo "ERROR: Dark Factory venv missing at ${DARK_FACTORY_HOME}/.venv" >&2
  echo "Run: ${DARK_FACTORY_HOME}/install.sh" >&2
  exit 1
fi

# Extract --backend value from argv (default: echo) without disturbing
# the rest of the argument list. Cheap linear scan is fine — bash only.
PREFLIGHT_BACKEND="${DARK_FACTORY_BACKEND:-}"
prev=""
for arg in "$@"; do
  if [[ "${prev}" == "--backend" ]]; then
    PREFLIGHT_BACKEND="${arg}"
    break
  fi
  prev="${arg}"
done
PREFLIGHT_BACKEND="${PREFLIGHT_BACKEND:-echo}"

# Preflight: probe the configured backend and warn-or-fail before
# we hand off to the Python runner. Best-effort: if preflight itself
# crashes (e.g. module import error in dev), fall through to the
# original runner path so we don't block legitimate runs.
PREFLIGHT_JSON=""
PREFLIGHT_RC=0
PREFLIGHT_JSON="$(
  env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
    "${VENV_PYTHON}" -m runner.preflight \
    --backend "${PREFLIGHT_BACKEND}" --json 2>/dev/null
)" || PREFLIGHT_RC=$?

if [[ "${PREFLIGHT_RC}" -eq 2 ]]; then
  # Hard-stop: zero backends reachable. Print the JSON to stderr
  # and exit 2 so callers (cron, automation) can detect the failure.
  echo "${PREFLIGHT_JSON}" >&2
  exit 2
elif [[ "${PREFLIGHT_RC}" -eq 0 && -n "${PREFLIGHT_JSON}" ]]; then
  # Pass or warn. For warn, print a single yellow line + recommendation
  # to stderr and continue. We use a minimal awk parse of the JSON
  # fields we need (no jq dependency) — structured consumers can
  # re-run the preflight module directly with --json.
  STATUS=""
  FALLBACK=""
  STATUS="$(printf '%s' "${PREFLIGHT_JSON}" | awk -F'"' '/"status":/ {print $4; exit}')"
  FALLBACK="$(printf '%s' "${PREFLIGHT_JSON}" | awk -F'"' '/"fallback_recommendation":/ {print $4; exit}')"
  if [[ "${STATUS}" == "warn" ]]; then
    printf '\033[33mwarning\033[0m: %s missing; falling back to %s\n' \
      "${PREFLIGHT_BACKEND}" "${FALLBACK}" >&2
  fi
fi

# agy-safe: install the FileNotFoundError monkey-patch for the agy
# subprocess BEFORE the runner Python code runs. handlers.py:627 has
# an unguarded Popen that panics when agy is missing; this shim
# returns a stub Popen (exit 127 + "backend_missing=true") so the
# codergen node returns a clean Result instead of a traceback.
# No-op when agy is on PATH. Stop-gap for the WIP branch's upstream
# try/except in handlers.py.
env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
  "${VENV_PYTHON}" -m runner._agy_safe >/dev/null 2>&1 || true

# Resolve the effective workdir the same way the runner will see it:
# explicit --workdir <PATH> wins, otherwise the script's cwd. This
# value becomes the merge_train lock key so a second invocation
# against the SAME workdir (regardless of which cwd it was launched
# from) hard-stops with rc=3.
__DF_LOCK_TARGET="${TARGET_WORKDIR}"
__DF_ARG_LOCK_PREV=""
for __df_arg in "$@"; do
  if [[ "${__DF_ARG_LOCK_PREV}" == "--workdir" && -n "${__df_arg}" ]]; then
    __DF_LOCK_TARGET="${__df_arg}"
  fi
  # Handle --workdir=/path format
  if [[ "${__df_arg}" == --workdir=* ]]; then
    __DF_LOCK_TARGET="${__df_arg#--workdir=}"
  fi
  __DF_ARG_LOCK_PREV="${__df_arg}"
done
# Normalize to canonical absolute path to ensure equivalent directories
# map to the same lock key (resolves symlinks, relative paths, ~)
if [[ -d "${__DF_LOCK_TARGET}" ]]; then
  __DF_LOCK_TARGET="$(cd "${__DF_LOCK_TARGET}" && pwd -P)"
fi

# merge_train acquire: claim the per-target-repo lock so a second
# concurrent dark-factory invocation against the same workdir
# hard-stops here with rc=3. The EXIT trap (set above) releases
# on every exit path. Run id is timestamp+pid so two simultaneous
# wrappers do not collide.
__DF_LOCK_RUN_ID="df-$(date +%s%N)-$$"
if ! env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
    "${VENV_PYTHON}" -m runner._merge_train acquire \
    --target "${__DF_LOCK_TARGET}" --run-id "${__DF_LOCK_RUN_ID}" \
    >/dev/null 2>&1; then
  # Re-run the acquire non-silently so we can show the holder on stderr.
  # If this succeeds (holder released between attempts), proceed normally.
  if env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
      "${VENV_PYTHON}" -m runner._merge_train acquire \
      --target "${__DF_LOCK_TARGET}" --run-id "${__DF_LOCK_RUN_ID}" >&2; then
    : # Lock acquired on retry, continue to runner
  else
    echo "ERROR: another dark-factory run is editing ${__DF_LOCK_TARGET}" >&2
    # Clear the run_id so the EXIT trap's release is a no-op.
    __DF_LOCK_RUN_ID=""
    exit 3
  fi
fi

has_workdir=0
for arg in "$@"; do
  if [[ "${arg}" == "--workdir" ]]; then
    has_workdir=1
    break
  fi
done

args=("$@")
if [[ "${has_workdir}" -eq 0 ]]; then
  args=(--workdir "${TARGET_WORKDIR}" "$@")
fi

# NOTE: do NOT use ``exec`` here — that would replace the bash shell
# and the EXIT trap would never fire when Python exits non-zero.
env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
  "${VENV_PYTHON}" -m runner "${args[@]}"
