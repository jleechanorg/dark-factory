#!/usr/bin/env python3
"""Deterministic conformance entrypoint for local Attractor-style harnesses."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
if VENV_PYTHON.exists() and pathlib.Path(sys.executable).resolve() != VENV_PYTHON.resolve():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(pathlib.Path(__file__).resolve()), *sys.argv[1:]])

if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from runner.engine import run as run_graph  # noqa: E402
from runner.handlers import Context, TYPE_REGISTRY  # noqa: E402
from runner.parser import is_exit_node, is_start_node, parse  # noqa: E402
from runner.prompt_substitution_audit import (  # noqa: E402
    audit_prompts as audit_prompts_tree,
)


def _pipelines() -> list[pathlib.Path]:
    # Library fragments (`_*.dot`) are included by lanes via `include="@..."` and
    # are intentionally free of `start`/`exit` (the parser loads them with
    # `require_start_exit=False` — see `runner.parser.parse`). Walking them in
    # `validate` would produce a spurious "missing start/exit" error and flip
    # `conformance score` RED, which in turn trips the test + Skeptic CI gates.
    # Filter them out at the walker so the parser invariant stays strict.
    def _walk(top: pathlib.Path) -> list[pathlib.Path]:
        return sorted(
            p for p in top.rglob("*.dot") if not p.name.startswith("_")
        )

    return _walk(ROOT / "pipelines") + _walk(ROOT / "benchmarks")


def _graph_payload(path: pathlib.Path) -> dict:
    graph = parse(path)
    return {
        "name": graph.name,
        "goal": graph.goal,
        "attrs": graph.attrs,
        "nodes": [
            {"id": node.name, "shape": node.shape, "attrs": node.attrs, **node.attrs}
            for node in sorted(graph.nodes.values(), key=lambda n: n.name)
        ],
        "edges": [
            {
                "from": edge.src,
                "to": edge.dst,
                "source": edge.src,
                "target": edge.dst,
                "src": edge.src,
                "dst": edge.dst,
                "attrs": edge.attrs,
                **edge.attrs,
            }
            for edge in sorted(graph.edges, key=lambda e: (e.src, e.dst, str(e.attrs)))
        ],
    }


def _resolve_path(raw: str) -> pathlib.Path:
    path = pathlib.Path(raw)
    return path if path.is_absolute() else ROOT / path


def _display_path(path: pathlib.Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def cmd_parse(args: argparse.Namespace) -> int:
    path = _resolve_path(args.dot_file)
    try:
        payload = _graph_payload(path)
    except Exception as exc:
        payload = {"diagnostics": [_diagnostic("parse", "error", str(exc))], "error": type(exc).__name__}
        print(json.dumps(payload, indent=2))
        return 1
    print(json.dumps(payload, indent=2))
    return 0


def _diagnostic(rule: str, severity: str, message: str, node_id: str | None = None) -> dict:
    return {"rule": rule, "severity": severity, "message": message, "node_id": node_id}


# Level-5 invariants — see
# project_2026-06-22_g3_closure_dynamic_node_design.md for the locked design.
#
# Trigger: pipelines/factory/*.dot (excluding hello.dot smoke lane) OR any
# .dot with graph [level5="true"] attribute. Slim / hello / library fragments
# are exempt so iteration lanes don't fight the rule.

_LEVEL5_HARD_TIER_REVIEWERS = ("codex exec", "agy --print", "claude -p")
_LEVEL5_PARALLEL_REVIEWER_PRIORITY = ("codex", "minimax", "agy", "claude-sonnet")


def _vendor_name(name: str) -> str:
    value = name.strip().lower()
    if value in {"claude", "claude-sonnet"}:
        return "claude"
    return value


def _priority_crosses_vendor(priority: list[str], graph_vendor: str | None) -> bool:
    if graph_vendor is None:
        return True
    graph_vendor = _vendor_name(graph_vendor)
    return any(_vendor_name(item) != graph_vendor for item in priority)


def _is_level5_path(path: pathlib.Path) -> bool:
    """True iff the path falls under pipelines/factory/ but is not the smoke lane.

    Library fragments (`_*.dot`) are pre-filtered by the walker; we still
    defend against explicit invocations to keep the invariant strict.
    """
    if path.name.startswith("_"):
        return False
    try:
        rel = path.relative_to(ROOT)
    except ValueError:
        return False
    parts = rel.parts
    if len(parts) < 2 or parts[0] != "pipelines" or parts[1] != "factory":
        return False
    # `hello.dot` is the smoke / wiring lane — never a Level-5 pipeline.
    return path.name != "hello.dot"


def _has_cross_vendor_reviewer(graph, graph_backend: str | None) -> bool:
    """A reviewer node whose backend can be cross-vendor.

    Legacy graphs used raw tool commands (`codex exec`, `agy --print`,
    `claude -p`). New graphs should use `type="parallel_reviewer"` with a
    backend priority queue so the normal review and shadow Codex output are
    one logged/audited node. Empty/unset graph backend always passes the
    cross-vendor requirement because the runner decides at run-time.
    """
    graph_vendor = (graph_backend or "").strip().lower() or None
    for node in graph.nodes.values():
        node_type = str(node.attrs.get("type", "") or "").strip().lower()
        if node_type == "parallel_reviewer":
            raw_priority = str(node.attrs.get("backend_priority", "") or "").strip()
            priority = (
                [p.strip() for p in raw_priority.split(",") if p.strip()]
                if raw_priority
                else list(_LEVEL5_PARALLEL_REVIEWER_PRIORITY)
            )
            prefer_adversarial = (
                str(node.attrs.get("prefer_adversarial", "") or "").strip().lower()
                in {"true", "1", "yes", "on"}
            )
            if prefer_adversarial:
                return True
            if _priority_crosses_vendor(priority, graph_vendor):
                return True

        command = str(node.attrs.get("command", "") or "").strip().lower()
        if not command:
            continue
        for prefix in _LEVEL5_HARD_TIER_REVIEWERS:
            if command.startswith(prefix):
                # If the graph pins a backend, the reviewer must be a
                # different vendor. Codex CLI vs. claude backend, agy vs.
                # claude, etc. Unknown/unset graph vendor = always OK.
                if graph_vendor is None:
                    return True
                prefix_vendor = prefix.split()[0]  # e.g. "codex" or "agy"
                if prefix_vendor != graph_vendor and prefix_vendor != "claude":
                    return True
                # `claude -p` with a non-claude backend counts as cross-vendor.
                if prefix_vendor == "claude" and graph_vendor != "claude":
                    return True
                return False
    return False


def _check_level5(graph, path: pathlib.Path) -> list[dict]:
    """Run the Level-5 rule set; return diagnostics (empty when exempt)."""
    diagnostics: list[dict] = []

    graph_attrs = getattr(graph, "attrs", {}) or {}
    graph_level5 = str(graph_attrs.get("level5", "")).strip().lower() == "true"
    if not (graph_level5 or _is_level5_path(path)):
        return diagnostics

    graph_backend = str(graph_attrs.get("backend", "") or "").strip() or None

    # --- HARD TIER (errors) ---

    has_gate_er = False
    has_gate_skeptic = False
    for node in graph.nodes.values():
        ntype = str(node.attrs.get("type", "") or "").strip().lower()
        if ntype in {"gate_er", "gate_evidence_audit"}:
            has_gate_er = True
        if ntype == "gate_skeptic" or node.name == "gate_skeptic":
            has_gate_skeptic = True

    if not has_gate_er:
        diagnostics.append(
            _diagnostic(
                "missing_hard_tier_gate",
                "error",
                "Level-5 graph must contain a node with type=\"gate_er\" "
                "(evidence review). See G3 closure design.",
            )
        )
    if not has_gate_skeptic:
        diagnostics.append(
            _diagnostic(
                "missing_hard_tier_gate",
                "error",
                "Level-5 graph must contain a node with type=\"gate_skeptic\" "
                "(inverted-incentive skeptic review). See G3 closure design.",
            )
        )
    if not _has_cross_vendor_reviewer(graph, graph_backend):
        diagnostics.append(
            _diagnostic(
                "missing_hard_tier_gate",
                "error",
                "Level-5 graph must contain a cross-vendor adversarial "
                "reviewer node (type=\"parallel_reviewer\" or command starting with one of: "
                + ", ".join(_LEVEL5_HARD_TIER_REVIEWERS)
                + ") that is not the same vendor as the graph backend.",
            )
        )

    # --- SOFT TIER (warnings; skip_<x>="true" allows opt-out) ---

    skip_holdout = str(graph_attrs.get("skip_holdout", "")).strip().lower() == "true"
    skip_spec = str(graph_attrs.get("skip_spec_validation", "")).strip().lower() == "true"

    has_holdout = any(
        str(node.attrs.get("type", "") or "").strip().lower() == "holdout_eval"
        for node in graph.nodes.values()
    )
    if not has_holdout and not skip_holdout:
        diagnostics.append(
            _diagnostic(
                "missing_soft_tier_node",
                "warning",
                "Level-5 graph is missing a holdout_eval node; opt out with "
                "graph [skip_holdout=\"true\"] when no production code is "
                "touched.",
            )
        )

    has_healer = any(
        node.name == "healer"
        or (
            str(node.attrs.get("type", "") or "").strip().lower() == "tool"
            and "df-healer" in str(node.attrs.get("command", "") or "")
        )
        for node in graph.nodes.values()
    )
    if not has_healer:
        # Healer is post-failure only — soft tier without an opt-out flag.
        diagnostics.append(
            _diagnostic(
                "missing_soft_tier_node",
                "warning",
                "Level-5 graph is missing a `healer` node (typically a "
                "`type=\"tool\"` running `df-healer`). The Healer is "
                "post-failure only, so this is advisory.",
            )
        )

    has_spec = any(node.name == "spec_validation" for node in graph.nodes.values())
    if not has_spec and not skip_spec:
        diagnostics.append(
            _diagnostic(
                "missing_soft_tier_node",
                "warning",
                "Level-5 graph is missing a `spec_validation` node; opt out "
                "with graph [skip_spec_validation=\"true\"] when iterating "
                "on an existing spec.",
            )
        )

    return diagnostics


def _validate_one(path: pathlib.Path) -> tuple[list[dict], dict | None]:
    diagnostics: list[dict] = []
    try:
        graph = parse(path)
    except Exception as exc:
        message = str(exc)
        severity = "warning" if "unreachable nodes" in message else "error"
        diagnostics.append(_diagnostic(type(exc).__name__, severity, message))
        return diagnostics, None

    for node in graph.nodes.values():
        if node.shape == "box" and not node.prompt_ref:
            diagnostics.append(
                _diagnostic(
                    "missing_prompt",
                    "warning",
                    f"box node {node.name!r} has no prompt attribute",
                    node.name,
                )
            )
    diagnostics.extend(_check_level5(graph, path))
    return diagnostics, {
        "path": _display_path(path),
        "status": "pass" if not any(d["severity"] == "error" for d in diagnostics) else "fail",
        "nodes": len(graph.nodes),
        "edges": len(graph.edges),
    }


def cmd_validate(args: argparse.Namespace) -> int:
    paths = [_resolve_path(args.dot_file)] if args.dot_file else _pipelines()
    results = []
    diagnostics: list[dict] = []
    ok = True
    for path in paths:
        path_diags, result = _validate_one(path)
        diagnostics.extend(path_diags)
        if result is not None:
            results.append(result)
        if any(diag["severity"] == "error" for diag in path_diags):
            ok = False
            if result is None:
                results.append({"path": _display_path(path), "status": "fail"})

    # Prompt-substitution audit (P4 from proposals-2026-06-23.md). Catches
    # unwired ${state.X} keys, missing prompt files, and templated
    # one-liners. Runs against the real prompts/, pipelines/, runner/
    # trees so it works whether validating a single .dot or the full
    # pipeline set. The audit's own Violations are mapped to
    # _diagnostic so they appear in the same JSON envelope.
    prompts_dir = ROOT / "prompts"
    if prompts_dir.exists():
        prompt_violations = audit_prompts_tree(
            prompts_dir=prompts_dir,
            pipelines_dir=ROOT / "pipelines",
            runner_dir=ROOT / "runner",
            repo_root=ROOT,
        )
        for v in prompt_violations:
            diagnostics.append(
                _diagnostic(
                    f"prompt_{v.kind.lower()}",
                    "error",
                    v.message,
                    v.prompt,
                )
            )
            ok = False

    print(json.dumps({"diagnostics": diagnostics}, indent=2))
    return 0 if ok else 1


def _touch_mock_llm(graph) -> None:
    base_url = os.environ.get("OPENAI_BASE_URL", "").rstrip("/")
    if not base_url:
        return
    box_nodes = [node for node in graph.nodes.values() if node.shape == "box"]
    attempts = 0
    for node in box_nodes:
        max_retries = node.attrs.get("max_retries", 0)
        attempts += 1 + (max_retries if isinstance(max_retries, int) else 0)
    for _ in range(max(attempts, 1)):
        payload = json.dumps({"model": "gpt-4o", "input": "AttractorBench conformance ping"}).encode()
        request = urllib.request.Request(
            f"{base_url}/responses",
            data=payload,
            headers={"Content-Type": "application/json", "Authorization": "Bearer test-key"},
            method="POST",
        )
        try:
            urllib.request.urlopen(request, timeout=5).read()
        except Exception:
            return


def cmd_run(args: argparse.Namespace) -> int:
    try:
        path = _resolve_path(args.dot_file)
        graph = parse(path)
        _touch_mock_llm(graph)
        mock_url = getattr(args, "mock_url", None) or os.environ.get("OPENAI_BASE_URL", "")
        if mock_url:
            ctx = Context(goal=args.goal, workdir=args.workdir, backend="mock_llm")
            ctx.state["mock_url"] = mock_url
        else:
            ctx = Context(goal=args.goal, workdir=args.workdir, backend="echo")
        if args.feature:
            ctx.state["feature"] = args.feature
        history = run_graph(graph, ctx, max_steps=args.max_steps)
        success = bool(history and history[-1].outcome == "success")

        api_calls = 0
        tokens = 0
        for step in history:
            meta = getattr(step, "metadata", {}) or {}
            api_calls += int(meta.get("api_calls", 0))
            tokens += int(meta.get("total_tokens", 0))

        payload = {
            "subcommand": "run",
            "status": "success" if success else "fail",
            "outcome": "success" if success else "fail",
            "final_outcome": history[-1].outcome if history else "empty",
            "steps": [
                {"node": step.node, "outcome": step.outcome, "metadata": step.metadata}
                for step in history
            ],
            "cost": {"api_calls": api_calls, "tokens": tokens},
        }
        print(json.dumps(payload, indent=2))
        return 0 if success else 1
    except Exception as exc:
        payload = {
            "subcommand": "run",
            "status": "fail",
            "outcome": "error",
            "final_outcome": "error",
            "error": type(exc).__name__,
            "message": str(exc),
            "cost": {"api_calls": 0, "tokens": 0},
        }
        print(json.dumps(payload, indent=2))
        return 1


def cmd_list_handlers(_: argparse.Namespace) -> int:
    handlers = [
        {"name": "start", "type": "Mdiamond"},
        {"name": "exit", "type": "Msquare"},
        {"name": "codergen", "type": "box"},
        *({"name": name, "type": name} for name in sorted(TYPE_REGISTRY)),
    ]
    print(json.dumps(handlers, indent=2))
    return 0


def cmd_score(_: argparse.Namespace) -> int:
    try:
        started = time.monotonic()
        build = subprocess.run(
            [sys.executable, "-m", "compileall", "-q", str(ROOT / "runner")],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        tests = subprocess.run(
            [sys.executable, "-m", "pytest", "tests/", "-q", "--ignore=tests/test_conformance.py"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            # 240s — the warm suite is ~121s today; the old 120s cap was
            # tripping on a 1s over-shoot, which becomes a `conformance
            # score` flake that cascades into the test + Skeptic CI gates.
            timeout=240,
            check=False,
        )
        validation = subprocess.run(
            [sys.executable, str(ROOT / "bin" / "conformance"), "validate"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        runtime = subprocess.run(
            [sys.executable, str(ROOT / "bin" / "conformance"), "run", "pipelines/factory/hello.dot"],
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        elapsed = time.monotonic() - started
        passed = build.returncode == tests.returncode == validation.returncode == runtime.returncode == 0
        payload = {
            "subcommand": "score",
            "status": "pass" if passed else "fail",
            "scope": "local_mock",
            "build": {"status": "pass" if build.returncode == 0 else "fail", "returncode": build.returncode},
            "self_test": {"status": "pass" if tests.returncode == 0 else "fail", "returncode": tests.returncode},
            "conformance": {"status": "pass" if validation.returncode == 0 else "fail", "returncode": validation.returncode},
            "runtime": {"status": "pass" if runtime.returncode == 0 else "fail", "returncode": runtime.returncode},
            "tiers": {
                "local_mock": "pass" if passed else "fail",
                "sealed_benchmark": "not_run",
                "generated_attractorbench": "not_run",
            },
            "cost": {"api_calls": 0, "tokens": 0},
            "runtime_seconds": round(elapsed, 3),
        }
        print(json.dumps(payload, indent=2))
        return 0 if payload["status"] == "pass" else 1
    except Exception as exc:
        payload = {
            "subcommand": "score",
            "status": "fail",
            "error": type(exc).__name__,
            "message": str(exc),
        }
        print(json.dumps(payload, indent=2))
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="conformance")
    sub = parser.add_subparsers(dest="subcommand", required=True)
    parse_cmd = sub.add_parser("parse")
    parse_cmd.add_argument("dot_file")
    parse_cmd.set_defaults(func=cmd_parse)
    validate_cmd = sub.add_parser("validate")
    validate_cmd.add_argument("dot_file", nargs="?")
    validate_cmd.set_defaults(func=cmd_validate)
    run_cmd = sub.add_parser("run")
    run_cmd.add_argument("dot_file")
    run_cmd.add_argument("--goal", default="conformance run")
    run_cmd.add_argument("--feature", default="hello")
    run_cmd.add_argument("--workdir", type=pathlib.Path, default=ROOT)
    run_cmd.add_argument("--max-steps", type=int, default=100)
    run_cmd.add_argument("--mock-url")
    run_cmd.set_defaults(func=cmd_run)
    sub.add_parser("list-handlers").set_defaults(func=cmd_list_handlers)
    sub.add_parser("score").set_defaults(func=cmd_score)
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
