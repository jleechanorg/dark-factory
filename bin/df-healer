#!/usr/bin/env bash
# Dark Factory Healer — CXDB failure clustering.

set -euo pipefail

# Capture original CLI arguments before trap overwrites $@
_ORIGINAL_ARGV=("$@")

# ---------------------------------------------------------------------------
# Top-level panic hook — writes a crash artifact on any non-zero exit.
# The Healer is the most likely wrapper to crash on bad CXDB data,
# so the artifact is most useful here.
#
# Use a guard variable (__DF_PANIC_FIRED) so the trap runs at most
# once even when both ERR and EXIT fire for the same failure, and
# do NOT use ``exec`` for the Python subprocess so the bash shell
# stays alive to actually run the EXIT trap on Python's exit code.
# ---------------------------------------------------------------------------
__df_panic_fired=0
__df_panic_collect() {
  local rc="$1" line="$2"
  if [[ "${rc}" -ne 0 && "${__df_panic_fired}" -eq 0 && -n "${VENV_PYTHON:-}" && -x "${VENV_PYTHON}" ]]; then
    __df_panic_fired=1
    local argv_json
    argv_json="$(printf '%s\0' "$0" "${_ORIGINAL_ARGV[@]}" | python3 -c 'import json,sys;data=sys.stdin.buffer.read().split(b"\x00");data=[x.decode("utf-8","replace") for x in data if x];print(json.dumps(data))' 2>/dev/null || printf '[]')"
    env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
      "${VENV_PYTHON}" -m runner.panic_hook \
      --exit-code "${rc}" \
      --line "${line}" \
      --bash-argv "${argv_json}" >/dev/null 2>&1 || true
  fi
  exit "${rc}"
}
trap '__df_panic_collect $? $LINENO' EXIT

_SCRIPT_REAL="$([ -L "${BASH_SOURCE[0]}" ] && readlink -f "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${_SCRIPT_REAL}")" && pwd)"
RESOLVED_HOME="$(cd "${SCRIPT_DIR}/.." && pwd)"
PINNED_HOME=""
if [[ -f "${RESOLVED_HOME}/.dark-factory-runtime-root" ]]; then
  IFS= read -r PINNED_HOME < "${RESOLVED_HOME}/.dark-factory-runtime-root"
fi
if [[ "${PINNED_HOME}" == "${RESOLVED_HOME}" ]]; then
  export DARK_FACTORY_HOME="${RESOLVED_HOME}"
else
  export DARK_FACTORY_HOME="${DARK_FACTORY_HOME:-${RESOLVED_HOME}}"
fi
VENV_PYTHON="${DARK_FACTORY_HOME}/.venv/bin/python"

if [[ ! -x "${VENV_PYTHON}" ]]; then
  echo "ERROR: Dark Factory venv missing at ${DARK_FACTORY_HOME}/.venv" >&2
  echo "Run: ${DARK_FACTORY_HOME}/install.sh" >&2
  exit 1
fi

# Extract --backend value from argv (default: echo per runner/healer.py:209)
# without disturbing the rest of the argument list. Cheap linear scan is
# fine — bash only. Echo is the no-LLM default but a Healer run on echo
# still works — only the prescription step is no-op.
PREFLIGHT_BACKEND="${HEALER_BACKEND:-}"
prev=""
for arg in "$@"; do
  if [[ "${prev}" == "--backend" ]]; then
    PREFLIGHT_BACKEND="${arg}"
    break
  elif [[ "${arg}" == --backend=* ]]; then
    PREFLIGHT_BACKEND="${arg#--backend=}"
    break
  fi
  prev="${arg}"
done
PREFLIGHT_BACKEND="${PREFLIGHT_BACKEND:-echo}"

PREFLIGHT_JSON=""
PREFLIGHT_RC=0
PREFLIGHT_JSON="$(
  env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
    "${VENV_PYTHON}" -m runner.preflight \
    --backend "${PREFLIGHT_BACKEND}" --json 2>/dev/null
)" || PREFLIGHT_RC=$?

if [[ "${PREFLIGHT_RC}" -eq 2 ]]; then
  echo "${PREFLIGHT_JSON}" >&2
  exit 2
elif [[ "${PREFLIGHT_RC}" -eq 0 && -n "${PREFLIGHT_JSON}" ]]; then
  STATUS=""
  FALLBACK=""
  STATUS="$(printf '%s' "${PREFLIGHT_JSON}" | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  FALLBACK="$(printf '%s' "${PREFLIGHT_JSON}" | sed -n 's/.*"fallback_recommendation"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
  if [[ "${STATUS}" == "warn" ]]; then
    printf '\033[33mwarning\033[0m: %s missing; falling back to %s\n' \
      "${PREFLIGHT_BACKEND}" "${FALLBACK}" >&2
    if [[ -n "${FALLBACK}" ]]; then
      new_argv=()
      backend_replaced=0
      prev=""
      for arg in "$@"; do
        if [[ "${prev}" == "--backend" ]]; then
          new_argv+=("${FALLBACK}")
          backend_replaced=1
        elif [[ "${arg}" == --backend=* ]]; then
          new_argv+=("--backend=${FALLBACK}")
          backend_replaced=1
        else
          new_argv+=("${arg}")
        fi
        prev="${arg}"
      done
      if [[ "${backend_replaced}" -eq 0 ]]; then
        new_argv=("--backend" "${FALLBACK}" "${new_argv[@]}")
      fi
      set -- "${new_argv[@]}"
    fi
  fi
fi

# NOTE: do NOT use ``exec`` here — that would replace the bash shell
# and the EXIT trap would never fire when Python exits non-zero.
env PYTHONPATH="${DARK_FACTORY_HOME}${PYTHONPATH:+:${PYTHONPATH}}" \
  "${VENV_PYTHON}" -m runner.healer "$@"
