<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: local.dark-factory.qw5-pilot-dispatch.plist.template
  Purpose: one-shot launchd timer that fires daemon/qw5-pilot-dispatch.sh
           ~2h after this plist is bootstrapped. Self-unloads on first run.

  Usage (manual install):
    launchctl bootstrap gui/$UID "$HOME/Library/LaunchAgents/local.dark-factory.qw5-pilot-dispatch.plist"
    # (or `launchctl load -w` for legacy) but launchctl bootstrap is preferred on macOS 11+.

  Recovery after a missing or blank MiniMax key:
    Configure MINIMAX_API_KEY in a profile sourced by the dispatch script
    (for example, ~/.bash_profile) or in the launchd environment, then run:
    launchctl kickstart -k gui/$(id -u)/local.dark-factory.qw5-pilot-dispatch
    The failed run leaves this job loaded and does not create the dispatch
    sentinel, so the kickstart immediately retries the one-shot job.

  Disarm:
    rm /tmp/jleechan-qw5-dispatch.done
    launchctl bootout gui/$UID "$HOME/Library/LaunchAgents/local.dark-factory.qw5-pilot-dispatch.plist"

  Notes:
    - The plist uses StartCalendarInterval with explicit Year/Month/Day/Hour/Minute
      so it's a one-shot at the configured wall-clock time. After firing, the dispatch
      script writes /tmp/jleechan-qw5-dispatch.done and self-unloads the plist.
    - When you generate the real plist from this template, fill in 2026, 07,
      04, 18, 49 with the target date/time for the dispatch.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.dark-factory.qw5-pilot-dispatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jleechan/projects/dark-factory/daemon/qw5-pilot-dispatch.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Year</key><integer>2026</integer>
        <key>Month</key><integer>07</integer>
        <key>Day</key><integer>04</integer>
        <key>Hour</key><integer>18</integer>
        <key>Minute</key><integer>49</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/jleechan-qw5-dispatch.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/jleechan-qw5-dispatch.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
