<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: ai.dark-factory.af-tick.plist.template
  Purpose: poll-loop launchd agent that fires daemon/factory-af-tick.sh
           every @TICK_INTERVAL@ seconds (default 240 = 4 min). Auto-restarts
           on exit (KeepAlive=true) with a ThrottleInterval of 60s to
           suppress crash-loop thrash (acceptance: "watchdog for crash-loop
           detection" from bead jleechan-57h0).

  Invocation:
    The plist invokes daemon/launchd/launchd-wrapper.sh which sources the
    user's interactive login env (PATH, git config, SSH agent, homebrew bins)
    before exec'ing factory-af-tick.sh. launchd's bare PATH would otherwise
    leave br / gh / sqlite3 / python3 / callpath unresolvable.

  Usage (manual install):
    launchctl bootstrap gui/$UID "$HOME/Library/LaunchAgents/ai.dark-factory.af-tick.plist"

  Disarm:
    launchctl bootout gui/$UID "$HOME/Library/LaunchAgents/ai.dark-factory.af-tick.plist"
    rm "$HOME/Library/LaunchAgents/ai.dark-factory.af-tick.plist"

  Notes:
    - @TICK_INTERVAL@ is substituted by install-launchagents.sh from the
      AFD_TICK_INTERVAL_SEC env var (default 240).
    - ThrottleInterval=60 caps restart rate: launchd will not restart the
      agent more than once per 60s, so a 1s-exit crash loop won't burn CPU.
    - ProcessType=Background marks this as a long-running background agent
      (lower scheduling priority than Interactive tasks).
    - Replace @HOME@ with $HOME at install time (see install-launchagents.sh).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.dark-factory.af-tick</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/projects/dark-factory/daemon/launchd/launchd-wrapper.sh</string>
        <string>@HOME@/projects/dark-factory/daemon/factory-af-tick.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>@TICK_INTERVAL@</integer>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/dark-factory/af-tick.out.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/dark-factory/af-tick.err.log</string>

    <!--
      Slack #factory notifications. libnotify-slack.sh no-ops when
      HERMES_SLACK_BOT_TOKEN is empty, so leaving the token unset keeps the
      daemon running normally — it just won't post to Slack.

      FACTORY_SLACK_CHANNEL_ID is committed literally because Slack channel
      ids are NOT secrets (they are public identifiers shown in URLs). The
      current channel id (C0BGEC77EP4) corresponds to the #factory channel
      created on 2026-07-09 via Slack API in team T09FXQ4LCQP.

      HOW TO ENABLE (operator-only; NEVER commit a real token):
        1. #factory already exists with id C0BGEC77EP4 — no operator action.
        2. Set HERMES_SLACK_BOT_TOKEN in your shell environment (or place it
           in /usr/local/etc/hermes-token readable by $USER) and run
           install-launchagents.sh, which substitutes the @HERMES_SLACK_BOT_TOKEN@
           placeholder into the rendered plist. The script refuses to write a
           plist with an empty token.
        3. Verify with:
             launchctl print gui/$UID/ai.dark-factory.af-tick | grep -A4 EnvironmentVariables
           The token value will be visible to the running user only; do not
           cat the rendered plist in a shared screen.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>FACTORY_SLACK_CHANNEL_ID</key>
        <string>C0BGEC77EP4</string>
        <!-- @HERMES_SLACK_BOT_TOKEN@ is substituted at install time by
             install-launchagents.sh from the operator's environment (or
             /usr/local/etc/hermes-token). Do NOT commit a real token. -->
        <key>HERMES_SLACK_BOT_TOKEN</key>
        <string>@HERMES_SLACK_BOT_TOKEN@</string>
    </dict>
</dict>
</plist>