# Auto-Factory Daemon config contract (spec §4.2.9, design doc §5).
# Honored by daemon/factory-overlay.sh (bash path; restored in PR #167 from
# e60b5a31b~1:daemon/factory-lite-harness.sh) and the Rust daemon (production
# path; same CXDB contract). The factory-lite skill plane was decommissioned
# in commit e60b5a31b — do not re-introduce.
# Live copy: config/daemon.toml (git-ignored per deployment).

target_repo = "jleechanorg/dark-factory"  # exactly one repo (pilot scope)
ao_project = "dark-factory"       # Agent Orchestrator project key; may differ from repo slug
base_branch = "main"
stage = 1                    # 1 = verifier plane only (re-roll verdicts recorded, never executed)
max_workers = 30             # spec §4.2.8 / ao-spawn-safety
max_batch = 15
fast_tick_secs = 60          # beads with an open PR (ATTESTED)
slow_tick_secs = 600         # intake scan
autonomy_timebox_secs = 10800  # 3h cumulative per bead chain
budget_warn_usd = 20.0       # 80%-threshold telemetry warning; monitoring-only
spec_dir = ".factory/specs/" # per-repo override via .factory.toml (spec Appendix B)
