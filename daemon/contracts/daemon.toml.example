# Auto-Factory Daemon config contract (spec §4.2.9, design doc §5).
# Honored by daemon/factory-overlay.sh (bash path; restored in PR #167 from
# e60b5a31b~1:daemon/factory-lite-harness.sh) and the Rust daemon (production
# path; same CXDB contract). The factory-lite skill plane was decommissioned
# in commit e60b5a31b — do not re-introduce.
# Live copy: config/daemon.toml (git-ignored per deployment).

target_repo = "jleechanorg/dark-factory"  # exactly one repo (pilot scope)
ao_project = "dark-factory"       # Agent Orchestrator project key; may differ from repo slug
base_branch = "main"
stage = 1                    # 1 = verifier plane only (re-roll verdicts recorded, never executed)
max_workers = 30             # spec §4.2.8 / ao-spawn-safety
max_batch = 15
fast_tick_secs = 60          # beads with an open PR (ATTESTED)
slow_tick_secs = 600         # intake scan
autonomy_timebox_secs = 10800  # 3h cumulative per bead chain
budget_warn_usd = 20.0       # 80%-threshold telemetry warning; monitoring-only
spec_dir = ".factory/specs/" # per-repo override via .factory.toml (spec Appendix B)

# Fail-closed re-roll proceed predicate windows (bead jleechan-zeij / issue
# #322 r3). OPTIONAL — omitting both defaults to the production values below.
# The re-roll engine supersedes a worker only after positively confirming it
# is safe to replace; these tune how long that confirmation takes.
reroll_head_stability_window_secs = 30  # branch HEAD + non-running activity must hold stable this long before superseding a still-present worker
reroll_death_confirm_secs = 5           # post-stop re-attach must observe continuous SessionNotFound this long to declare positive death (the fast path)

# Held-bead re-assessment cooldown (bead jleechan-zaga / issue #348 r3).
# OPTIONAL — omitting it defaults to 900s. A bead held DISPOSITION_REQUIRED
# (blocked only by a structural gate the coder cannot drive — CodeRabbit
# unavailable, etc.) is re-assessed at most this often, so a hours-long
# structural condition does not re-hit the SCM API every fast tick.
held_recheck_cooldown_secs = 900        # 15 minutes between re-assessments of a DISPOSITION_REQUIRED bead

# Pre-gate PR drift validation (bead jleechan-t40t / issue #326). OPTIONAL —
# omitting it defaults to TRUE. Before each gate assessment the daemon
# confirms the bead's stored pr_number is an OPEN PR whose head ref matches
# the bead's branch; on drift it re-resolves by branch (or demotes to
# DISPATCHED when the branch has no live PR). Set false only for legacy/test
# deployments that cannot supply open_pr_head_ref data.
pre_gate_validation_enabled = true

# Multi-repo dispatch routing table (bead jleechan-35y4 Stage B; see
# docs/multirepo-dispatch-investigation-2026-07-11.md). OPTIONAL — omitting
# [repos] entirely is fully backward compatible: every bead resolves to the
# single `target_repo`/`ao_project` pair above, exactly like a pre-Stage-B
# config. Add an entry here for every additional repo a bead's Stage-A
# intake resolution (`target_repo:` body field or `external_ref` owner/repo
# prefix) may name. A bead whose resolved repo has NO entry here AND is not
# `target_repo` above parks HUMAN_HELD with reason `unmapped_target_repo`
# (fail loud — never silently dispatched into a guessed repo/AO project).
#
# [repos."jleechanorg/worldarchitect.ai"]
# ao_project = "worldarchitect"
# push_remote = "worldai"   # dual-remote clone; bare `git push` is WRONG here
#
# [repos."jleechanorg/dark-factory"]
# ao_project = "dark-factory"
# push_remote = "origin"
