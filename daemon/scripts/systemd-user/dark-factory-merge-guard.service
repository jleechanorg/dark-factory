[Unit]
Description=Dark Factory auto-merge-guard.sh merge-authority sweep (jleechan-s3c)
Documentation=https://github.com/jleechanorg/dark-factory
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart=/bin/bash @REPO@/daemon/scripts/auto-merge-guard.sh
Environment=HOME=%h
Environment=AFD_LOG=%h/Library/Logs/dark-factory/daemon.jsonl
# systemd's minimal user-unit environment does not define PATH, so gh / br /
# git / python3 (the guard's only external dependencies) would be unresolvable
# on every tick. Set the same default the systemd user manager inherits from
# /etc/environment on this host; auto-merge-guard.sh itself relies on absolute
# paths via its own PATH augmentation (see daemon/scripts/auto-merge-guard.sh).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Strip any shell-exported GITHUB_TOKEN/GH_TOKEN before the service runs so the
# user's keyring auth (gh CLI's default credential source on this host) takes
# effect for gh pr list / gh pr view / gh pr merge calls inside the guard.
# Without this, a stale or invalid GITHUB_TOKEN shadows the working keyring
# auth and every gh CLI call fails the same way (every timer tick rc=1).
# See bead jleechan-s3c and jleechan-p944.
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN
StandardOutput=append:%h/Library/Logs/dark-factory/merge-guard.out.log
StandardError=append:%h/Library/Logs/dark-factory/merge-guard.err.log