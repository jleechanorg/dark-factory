__pycache__/
*.py[cod]
.venv
.pytest_cache/
.checkpoints/
.dark-factory-runs/
.dark-factory-conformance/
generated-tasks/
jobs/
logs/
results/
tasks/
task-runs/
**/spec_review/
*.png
*.svg
firebase-debug.log
firestore-debug.log

# Agent worktrees (temporary subagent isolation; not part of canonical history)
.claude/worktrees/

# Generated by holdout_eval runs; not part of canonical history
results/holdout_results.json

# Generated evidence bundles are run artifacts. Keep raw bundles locally or
# publish them as PR artifacts; do not add new run directories by default.
evidence/

# Misc test artifacts
*_test.log

# Nested clone artifact left by factory pipeline runs (not canonical)
origin/

# Skeptic-gate run report (per-PR ephemeral; not canonical history)
specs/skeptic-report.json

# But: rendered diagram PNGs in diagrams/png/ are canonical docs, not test artifacts
!diagrams/png/*.png

# Dark-factory background runner WIP-exhausted commits previously registered
# this path as a gitlink (mode 160000) without a .gitmodules entry, breaking
# actions/checkout for every new PR. Block it at the index level so future
# factory runs cannot re-introduce the broken state.
worktree_factory_evolve/
# Rust daemon crate build artifacts (Cargo.lock IS committed — binary crate)
daemon/target/

# stray test/verify artifacts (cargo test scratch, DoD smoke)
test.db
.scratch_daemon_verify/
**/*.db-wal
**/*.db-shm

# Per-CLI agent hook configs (generated by scripts/setup-agent-hooks.sh).
# Each CLI uses its own settings schema, so they live in separate files,
# and they hardcode $HOME/.local/bin/conflict-warn-pre-tool.sh — both
# reasons they should NOT be committed. Regenerate per machine via the
# installer; never edit by hand.
.codex/
.cursor/
.gemini/
.opencode.json

# AO runtime state (machine-local, written by activity-updater hook)
.ao/
.claude/activity-updater.sh
.beads/.local_version
.githooks/pre-commit

# Generated runner diagnostics — per-run failure logs and per-branch
# failure-step markers dropped by the dark-factory runner when a pipeline
# exhausts retries. Not canonical history; regenerate per run.
failed_run_log*.txt
branch_fail_step_*
