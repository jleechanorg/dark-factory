#!/usr/bin/env bash
# Shim — mirrors /Users/jleechan/.config/git/hooks/pre-push pattern.
# Real logic lives in pre-push-{graph-audit,repro-artifact-guard,beads-guard}.sh.

set -euo pipefail

command -v git-lfs >/dev/null 2>&1 || {
  echo >&2 "This repository is configured for Git LFS but git-lfs was not found on PATH."
  exit 2
}

git lfs pre-push "$@"
"$(git rev-parse --show-toplevel)/.githooks/pre-push-repro-artifact-guard.sh"
"$(git rev-parse --show-toplevel)/.githooks/pre-push-beads-guard.sh"
"$(git rev-parse --show-toplevel)/.githooks/pre-push-graph-audit.sh" "$@"
