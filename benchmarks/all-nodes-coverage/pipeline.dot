digraph roman_benchmark {
    graph [
        goal="Implement to_roman per the inlined spec; verify against the sealed evaluator."
        label="AllNodesCoverage"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    plan      [type="codergen", label="Plan",      prompt="@benchmarks/all-nodes-coverage/prompts/plan.md",      timeout=600]
    implement [type="codergen", label="Implement", prompt="@benchmarks/all-nodes-coverage/prompts/implement.md", timeout=600]

    // verify is a sealed evaluator node opting into validation behaviour. On
    // success it clears `_unresolved_failure` so the exit node can report
    // `success` even after a prior verify -> fix loop. The implementation path
    // resolves to the AO worker's worktree when AO is used, otherwise ctx.workdir.
    verify [type="holdout_eval",
            label="sealed evaluator",
            validation="true",
            feature="roman",
            implementation="${state.ao.worktree}",
            timeout="180"]

    fix [type="codergen", label="Fix", prompt="@benchmarks/all-nodes-coverage/prompts/fix.md", max_visits="3", timeout=600]

    start -> plan -> implement -> verify
    verify -> exit [condition="outcome=success"]
    verify -> fix  [condition="outcome!=success"]
    fix    -> verify
}
