digraph airbnb_sprint1_eval {
    graph [
        goal="Sprint 1 eval-only: run sealed holdout evaluator against a pre-built implementation."
        label="AirbnbSprint1EvalOnly"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    // Pass --state ao.worktree=<path> to set the implementation path.
    verify [type="holdout_eval",
            label="sealed evaluator (S1)",
            validation="true",
            feature="airbnb-clone-sprint-1",
            implementation="${state.ao.worktree}",
            startup_delay="60",
            timeout="600"]

    start -> verify
    verify -> exit
}
