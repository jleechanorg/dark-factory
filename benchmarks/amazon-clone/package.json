{
  "name": "amazon-clone-mvp",
  "version": "1.0.0",
  "description": "Amazon Clone MVP with Node.js, Express, Vanilla JS frontend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "build": "npm install",
    "seed": "node -e \"require('./src/models/db').resetDB()\"",
    "validate-size": "python3 scripts/validate-size.py"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase": "^10.12.3",
    "firebase-admin": "^12.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
