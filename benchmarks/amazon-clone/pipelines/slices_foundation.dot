digraph amazon_foundation_slice {
    graph [label="Amazon Foundation Slice - Firestore/Auth"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    implement [type="codergen", label="Implement Foundation", prompt="@benchmarks/amazon-clone/prompts/slices/firestore_auth.md", timeout="600"]
    public_acceptance [type="tool", label="Foundation Public Gate", command="bash benchmarks/amazon-clone/scripts/public_foundation.sh .", timeout="300", validation="true"]
    fix [type="codergen", label="Fix Foundation", prompt="@benchmarks/amazon-clone/prompts/slices/fix_foundation.md", timeout="300", max_visits="5"]

    start -> implement -> public_acceptance
    public_acceptance -> exit [condition="outcome=success"]
    public_acceptance -> fix [condition="outcome!=success"]
    fix -> public_acceptance
}
