digraph AmazonCloneSmasher {
  graph [
    goal="Implement the Amazon Clone MVP from the visible spec",
    rankdir=LR
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit"]

  plan [
    type="codergen",
    label="Plan",
    prompt="@benchmarks/amazon-clone/prompts/plan.md",
    timeout=600
  ]

  implement [
    type="codergen",
    label="Implement",
    prompt="@benchmarks/amazon-clone/prompts/implement.md",
    max_retries=2,
    timeout=600
  ]

  test [
    type="tool",
    label="Public Acceptance",
    command="${state.amazon.public_command}",
    goal_gate=true,
    retry_target="fix",
    timeout=600
  ]

  holdout [
    type="tool",
    label="Redacted Holdout Score",
    command="${state.amazon.holdout_command}",
    goal_gate=true,
    retry_target="fix",
    timeout=900
  ]

  fix [
    type="codergen",
    label="Fix",
    prompt="@benchmarks/amazon-clone/prompts/fix.md",
    max_retries=2,
    timeout=600
  ]

  start -> plan
  plan -> implement
  implement -> test
  test -> holdout [condition="outcome=success"]
  test -> fix [condition="outcome!=success"]
  holdout -> exit [condition="outcome=success"]
  holdout -> fix [condition="outcome!=success"]
  fix -> test
}

