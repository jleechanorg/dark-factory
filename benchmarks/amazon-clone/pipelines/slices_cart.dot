digraph amazon_cart_slice {
    graph [label="Amazon Cart Slice - Cart/Wishlist/Addresses"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    implement [type="codergen", label="Implement Cart", prompt="@benchmarks/amazon-clone/prompts/slices/cart_wishlist_addresses.md", timeout="600"]
    public_acceptance [type="tool", label="Cart Public Gate", command="bash benchmarks/amazon-clone/scripts/public_cart.sh .", timeout="300", validation="true"]
    fix [type="codergen", label="Fix Cart", prompt="@benchmarks/amazon-clone/prompts/slices/fix_cart.md", timeout="300", max_visits="5"]

    start -> implement -> public_acceptance
    public_acceptance -> exit [condition="outcome=success"]
    public_acceptance -> fix [condition="outcome!=success"]
    fix -> public_acceptance
}
