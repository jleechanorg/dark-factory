digraph MinimalFeatureFactory {
  graph [
    goal="Implement a production-ready feature that passes tests, review, and behavioral holdouts",
    rankdir=LR
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit - Ready to Merge"]

  plan [
    type="codergen",
    label="Plan & Spec",
    prompt="@prompts/slim/plan.md"
  ]

  implement [
    type="codergen",
    label="Implement",
    prompt="@prompts/slim/implement.md",
    max_retries=2
  ]

  test [
    type="tool",
    label="Run Tests",
    command="${state.slim.test_command}",
    validation=true,
    goal_gate=true,
    retry_target="fix"
  ]

  review [
    type="codergen",
    label="Fresh Eyes Review",
    prompt="@prompts/slim/review.md",
    goal_gate=true,
    retry_target="fix"
  ]

  holdout [
    type="tool",
    label="Behavioral Holdouts",
    command="${state.slim.holdout_command}",
    validation=true,
    goal_gate=true,
    retry_target="fix"
  ]

  fix [
    type="codergen",
    label="Fix & Iterate",
    prompt="@prompts/slim/fix.md",
    max_retries=2
  ]

  start -> plan
  plan -> implement
  implement -> test

  test -> review [condition="outcome=success"]
  test -> fix [condition="outcome!=success"]

  review -> holdout [condition="outcome=success"]
  review -> fix [condition="outcome!=success"]

  holdout -> exit [label="All Gates Pass", condition="outcome=success"]
  holdout -> fix [label="Gates Failed", condition="outcome!=success"]

  fix -> test
}
