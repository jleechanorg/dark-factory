// pipelines/slim/two_node.dot
//
// Default graph for `/f` (and `/factory`). Exactly two productive nodes:
//   worker         — generic codergen; light prompt; does whatever the user asked.
//   cold_reviewer  — controller-owned cold reviewer using the SHA-pinned
//                    cold-review-v1 execution path (prompts/catalog/controller_cold_review_v1.md).
//
// Wiring:
//   start -> round_begin -> worker -> cold_reviewer -> round_end
//   round_end -> exit        [condition="outcome=success"]
//   round_end -> round_begin [condition="outcome!=success"]
//
// Backend routing:
//   - worker          honors the run-level --backend (the coder tier the user
//                     chose; default = whatever /f's Step 0.5 detector picks).
//   - cold_reviewer   uses review_contract="cold-review-v1" and
//                     backend_priority="codex" because the controller has
//                     a receipt-capable transport only for Codex.
//
// Failure semantics:
//   - Each round runs worker, then validates with cold_reviewer.
//   - On reviewer or worker failure below max_rounds, the next round begins.
//   - Reaching max_rounds (default 3) terminates exhausted without extra worker invocation.

digraph SlimTwoNode {
    graph [
        goal="Generic worker does the user's task; controller-owned cold-review-v1 reviewer gates it. Slim default for /f."
        rankdir=LR
        label="SlimTwoNode (default /f graph)"
        validation_rounds="true"
    ]

    start  [shape=Mdiamond, label="Start"]
    exit   [shape=Msquare,  label="Exit"]

    round_begin [
        type="round_begin",
        label="Begin Validation Round",
        members="worker,cold_reviewer"
    ]

    worker [
        type="codergen",
        label="Generic Worker",
        class="worker",
        prompt="@prompts/slim/worker.md",
        max_retries=2,
        timeout=600
    ]

    cold_reviewer [
        type="parallel_reviewer",
        label="Cold Reviewer (controller cold-review-v1)",
        class="review",
        review_contract="cold-review-v1",
        backend_priority="codex",
        evidence_paths="evidence/worker-verification.json",
        receipt_required="true",
        goal_gate=true,
        timeout=600
    ]

    round_end [
        type="round_end",
        label="End Validation Round",
        members="worker,cold_reviewer"
    ]

    start -> round_begin
    round_begin -> worker
    worker -> cold_reviewer
    cold_reviewer -> round_end

    round_end -> exit        [condition="outcome=success"]
    round_end -> round_begin [condition="outcome!=success"]
}
