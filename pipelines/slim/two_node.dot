// pipelines/slim/two_node.dot
//
// Default graph for `/f` (and `/factory`). Exactly two productive nodes:
//   worker         — generic codergen; light prompt; does whatever the user asked.
//   cold_reviewer  — fresh, fully tooled Codex process reviewing an isolated,
//                    runner-minted snapshot pin (never the live coder workdir).
//
// Wiring:
//   start -> worker -> cold_reviewer -> exit                (on success)
//                          \-> worker                        (on non-success, bounded max_visits=3)
//
// Backend routing:
//   - worker          honors the run-level --backend (the coder tier the user
//                     chose; default = whatever /f's Step 0.5 detector picks).
//   - cold_reviewer   always launches a fresh Codex CLI session.
//
// Reviewer identity and findings relay (typed targets / ungambeable reviewer,
// see docs/superpowers/specs/2026-09-01-factory-two-node-redesign-design.md):
//   - The reviewer never receives caller/worker free text. Its rendered input
//     is the static prompt + a runner-minted ${target} locator + a
//     runner-minted, Base64-encoded ${intent} envelope. The runner re-mints
//     and chains the pin after every worker visit (D8a).
//   - Reviewer FAIL relays typed, schema-validated findings
//     ({path, claim, required_fix}) to the worker as untrusted requirements
//     to verify, never raw prose and never commands.
//
// Failure semantics:
//   - cold_reviewer is goal_gate=true. On success the run exits.
//   - Budget is soft 1200 s (stated in the prompt so the model can emit an
//     UNFINISHED report) / hard 1320 s (runner kill). Any exit without a
//     machine-validated terminal `Verdict:` line — timeout, crash, malformed
//     output — classifies as `failure` and is fail-closed.
//   - Any non-success reviewer outcome (`outcome!=success`, covering both
//     `failure` and `error` classifications) routes back to worker directly.
//     Worker handles iteration (max_visits=3). No separate fix node in this graph.

digraph SlimTwoNode {
    graph [
        goal="Generic worker does the user's task; a fresh Codex reviewer gates it. Slim default for /f."
        rankdir=LR
        label="SlimTwoNode (default /f graph)"
    ]

    start  [shape=Mdiamond, label="Start"]
    exit   [shape=Msquare,  label="Exit"]

    worker [
        type="codergen",
        label="Generic Worker",
        class="worker",
        prompt="@prompts/slim/worker.md",
        max_retries=2,
        max_visits="3",
        timeout=600
    ]

    cold_reviewer [
        type="codergen",
        label="Fresh Codex Reviewer",
        class="review",
        backend="codex",
        prompt="@prompts/slim/fresh_review.md",
        verdict_gate="true",
        fresh_session="true",
        goal_gate=true,
        timeout=1320
    ]

    start -> worker
    worker -> cold_reviewer [condition="outcome=success"]
    worker -> worker        [condition="outcome!=success"]

    cold_reviewer -> exit   [condition="outcome=success"]
    cold_reviewer -> worker [condition="outcome!=success"]
}
