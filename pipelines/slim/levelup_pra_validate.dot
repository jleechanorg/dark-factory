digraph LevelUpPRAValidate {
  graph [
    goal="Validation-only on existing PR-A prompt diff: holdout + /er + /code_standards (+/es), each reports independently (no short-circuit, no implement/fix node)."
    label="PR-A Validate (gates-only)"
  ]
  rankdir=LR

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare,  label="Exit"]

  holdout [type="holdout_eval",        label="Behavioral Holdouts", feature="level-up-session", timeout=600]
  gate_es [type="gate_es",             label="/es Evidence Standards",                            timeout=600]
  gate_er [type="gate_er",             label="/er Evidence Review",                               timeout=600]
  gate_cs [type="gate_code_standards", label="/code_standards (ZFC + leveling + RCF)",            timeout=600]

  // Always flow forward — each gate emits its own verdict to the event log;
  // PR-A maps to ZERO holdout scenarios (§A.6), so we never short-circuit on
  // holdout failure (deletion-class scenarios fail by design until backend PRs land).
  start   -> holdout
  holdout -> gate_es
  gate_es -> gate_er
  gate_er -> gate_cs
  gate_cs -> exit
}
