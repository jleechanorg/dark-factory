digraph ReviewPR {
    graph [
        goal="PR review: cold codergen review + a real SHA-bound evidence gate (gate_er on agy, claude fallback). No holdout — holdouts test feature scenarios, not PR diffs."
        label="ReviewPR"
        rankdir=LR
    ]

    start  [shape=Mdiamond, label="Start"]
    exit   [shape=Msquare,  label="Exit"]

    // Cold fresh-eyes review. type=codergen → honors the run-level --backend
    // (set --backend agy for an independent adversarial pass). It can edit, so
    // it is NOT the merge-confidence reviewer; the gate below is.
    review  [
        type="codergen",
        label="Cold Review",
        class="review",
        prompt="@prompts/slim/review.md",
        goal_gate=true
    ]

    // Real evidence reviewer: SHA-bound, read-only, verdict-parsed. Pinned to
    // agy (independent of the coder backend) and falls back to claude only on
    // agy infrastructure failure (never reviewer-shops a real fail/partial).
    // gate_er echo-short-circuits on the run-level backend, so --backend echo
    // smoke still pre-seeds via ctx.state["evidence.outcome"].
    evidence [
        type="gate_er",
        label="Evidence Review (gate_er)",
        class="review",
        backend="agy",
        timeout=600
    ]

    start    -> review
    review   -> evidence  [condition="outcome=success"]
    review   -> exit      [condition="outcome!=success"]

    evidence -> exit
}
