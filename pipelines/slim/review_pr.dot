digraph ReviewPR {
    graph [
        goal="PR review: cold review + evidence gates (no holdout — holdouts test feature scenarios not PR diffs)."
        label="ReviewPR"
        rankdir=LR
    ]

    start  [shape=Mdiamond, label="Start"]
    exit   [shape=Msquare,  label="Exit"]

    review  [
        type="codergen",
        label="Cold Review",
        class="review",
        prompt="@prompts/slim/review.md",
        goal_gate=true
    ]
    evidence [
        type="codergen",
        label="Evidence Review",
        class="review",
        prompt="@prompts/slim/evidence_review.md"
    ]

    start    -> review
    review   -> evidence  [condition="outcome=success"]
    review   -> exit      [condition="outcome!=success"]

    evidence -> exit
}
