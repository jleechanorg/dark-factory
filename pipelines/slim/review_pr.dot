digraph ReviewPR {
    graph [
        goal="PR review: cold codergen review + a real SHA-bound evidence gate (gate_er on agy, claude fallback). No holdout — holdouts test feature scenarios, not PR diffs."
        label="ReviewPR"
        rankdir=LR
    ]

    start  [shape=Mdiamond, label="Start"]
    exit   [shape=Msquare,  label="Exit"]

    // Cold fresh-eyes review. type=codergen → honors the run-level --backend
    // (set --backend agy for an independent adversarial pass). It can edit, so
    // it is NOT the merge-confidence reviewer; the gate below is.
    review  [
        type="codergen",
        label="Cold Review",
        class="review",
        prompt="@prompts/slim/review.md",
        goal_gate=true
    ]

    // Real evidence reviewer: SHA-bound, read-only, verdict-parsed. Resolves
    // via the adversarial-review priority queue (codex > minimax > agy >
    // claude-sonnet) so the reviewer is a *different vendor* from the
    // implementing coder. prefer_adversarial: true guarantees the run-level
    // coder backend is excluded from the queue (a `claude` coder run cannot
    // accidentally get a `claude` reviewer). The agy→claude infra fallback
    // still applies (never reviewer-shops a real fail/partial). Priority list
    // comes from backend_priority= here; overridable per-run via
    // DARK_FACTORY_ADVERSARIAL_PRIORITY. gate_er echo-short-circuits on the
    // run-level backend, so --backend echo smoke still pre-seeds via
    // ctx.state["evidence.outcome"].
    evidence [
        type="gate_er",
        label="Evidence Review (gate_er)",
        class="review",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        timeout=600
    ]

    start    -> review
    review   -> evidence  [condition="outcome=success"]
    review   -> fix       [condition="outcome!=success"]

    evidence -> exit

    // Bounded fix loop: when the cold fresh-eyes review rejects the diff,
    // route through the fix prompt (bounded) so the lane can iterate on
    // the artifact rather than exit silently unreviewed (G1: the
    // evidence gate_er is the real merge-confidence reviewer).
    fix [
        type="codergen",
        label="Fix & Iterate",
        class="fix",
        prompt="@prompts/slim/fix.md",
        max_visits="3",
        timeout=600
    ]
    fix -> review
}
