digraph ReadyPRFactory {
  graph [
    goal="Enforce PR is /ready: verify CI tests, /es evidence, /er review, /advice approval, and holdouts with bounded N=3 fix iteration"
    label="PR Ready Enforcement"
    validation_rounds="true"
    skip_explore="true"
    skip_plan="true"
    skip_implement="true"
    rankdir=LR
    model_stylesheet="minimal_feature.model.css"
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit - Ready to Merge"]

  round_begin [
    type="round_begin",
    label="Begin Validation Round",
    members="test,gate_es,gate_er,gate_advice,holdout"
  ]

  // 1. Run deterministic CI tests / build check
  test [
    type="tool",
    label="Run CI Tests",
    command="${state.slim.test_command}",
    validation=true,
    goal_gate=true,
    timeout=600
  ]

  // 2. Gate 1: /es Evidence Standards (published gist linked in PR body)
  gate_es [
    type="gate_es",
    label="/es Evidence Standards",
    backend_priority="codex,minimax,agy,claude-sonnet",
    prefer_adversarial="true",
    gate_strict="true",
    timeout=600,
    goal_gate=true
  ]

  // 3. Gate 2: /er Adversarial Evidence Review (PASS verdict at current head)
  gate_er [
    type="gate_er",
    label="/er Evidence Review",
    backend_priority="codex,minimax,agy,claude-sonnet",
    prefer_adversarial="true",
    gate_strict="true",
    timeout=600,
    goal_gate=true
  ]

  // 4. Gate 3: /advice Independent Review Gate (APPROVE / comments handled)
  gate_advice [
    type="gate_slash",
    command="advice",
    label="/advice Independent Review",
    timeout=600,
    goal_gate=true
  ]

  // 5. Gate 4: Sealed Holdout Evaluation
  holdout [
    type="holdout_eval",
    label="Behavioral Holdouts",
    feature="${state.feature}",
    validation=true,
    goal_gate=true,
    timeout=600
  ]

  round_end [
    type="round_end",
    label="End Validation Round",
    members="test,gate_es,gate_er,gate_advice,holdout"
  ]

  // 6. Fix & Iterate Node (Bounded by validation rounds)
  fix [
    type="codergen",
    label="Fix & Iterate (max N=3)",
    class="fix",
    prompt="@prompts/slim/ready_fix.md",
    max_retries=0,
    no_progress_max="2",
    timeout=600
  ]

  start -> round_begin
  round_begin -> test
  test -> gate_es
  gate_es -> gate_er
  gate_er -> gate_advice
  gate_advice -> holdout
  holdout -> round_end

  round_end -> exit [condition="outcome=success"]
  round_end -> fix  [condition="outcome!=success"]

  fix -> round_begin
}
