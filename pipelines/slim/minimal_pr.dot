digraph MinimalPRFactory {
  graph [
    goal="Iterate on an in-flight PR: passes tests, review, and evidence gates"
    rankdir=LR
    model_stylesheet="minimal_feature.model.css"
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit - Ready to Merge"]

  plan [
    type="codergen",
    label="Plan & Spec",
    class="plan",
    prompt="@prompts/slim/plan.md"
  ]

  implement [
    type="codergen",
    label="Implement",
    class="implement",
    prompt="@prompts/slim/implement.md",
    max_retries=2
  ]

  test [
    type="tool",
    label="Run Tests",
    command="${state.slim.test_command}",
    validation=true,
    goal_gate=true,
    retry_target="fix"
  ]

  code_review [
    type="gate_code_standards",
    label="Code Review & Standards",
    goal_gate=true,
    retry_target="fix"
  ]

  evidence_review [
    type="gate_evidence_review",
    label="Evidence Standards Review",
    goal_gate=true,
    retry_target="fix"
  ]

  fix [
    type="codergen",
    label="Fix & Iterate",
    prompt="@prompts/slim/fix.md",
    max_retries=2
  ]

  start -> plan
  plan -> implement
  implement -> test

  test -> code_review [condition="outcome=success"]
  test -> fix [condition="outcome!=success"]

  code_review -> evidence_review [condition="outcome=success"]
  code_review -> fix [condition="outcome!=success"]

  evidence_review -> exit [condition="outcome=success"]
  evidence_review -> fix [condition="outcome!=success"]

  fix -> test
}
