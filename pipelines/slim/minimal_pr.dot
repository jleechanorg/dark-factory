digraph MinimalPRFactory {
  graph [
    include="@pipelines/_base.dot",
    goal="Iterate on an in-flight PR: passes tests, review, and evidence gates"
    rankdir=LR
    model_stylesheet="minimal_feature.model.css"
  ]

  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare, label="Exit - Ready to Merge"]

  // _base.dot provides: explore_in, explore_fanout, explore_{concept,auth,
  // reuse,risks}, explore_join, explore_out.

  // Research rides the coder backend (no class → run-level --backend),
  // read-only: digests explore findings into .dark-factory/research-findings.md
  // before the heavier plan model runs.
  research [
    type="codergen",
    label="Research (read-only)",
    prompt="@prompts/slim/research.md"
  ]

  plan [
    type="codergen",
    label="Plan & Spec",
    class="plan",
    prompt="@prompts/slim/plan.md"
  ]

  implement [
    type="codergen",
    label="Implement",
    class="implement",
    prompt="@prompts/slim/implement.md",
    max_retries=2
  ]

  test [
    type="tool",
    label="Run Tests",
    command="${state.slim.test_command}",
    validation=true,
    goal_gate=true,
    timeout=600,
    retry_target="fix"
  ]

  review [
    type="codergen",
    label="Fresh Eyes Review",
    class="review",
    prompt="@prompts/slim/review.md",
    goal_gate=true,
    retry_target="fix"
  ]

  holdout [
    type="holdout_eval",
    label="Behavioral Holdouts",
    feature="${state.feature}",
    validation=true,
    goal_gate=true,
    timeout=600,
    retry_target="fix"
  ]

  gate_es [
    type="gate_es",
    label="/es Evidence Standards",
    timeout=600
  ]

  // Resolves via the adversarial-review priority queue (codex > minimax >
  // agy is the final supported reviewer fallback so the reviewer is a *different vendor* from the
  // implementing coder. prefer_adversarial=true excludes the run-level
  // coder backend from the queue. Overridable per-run via
  // DARK_FACTORY_ADVERSARIAL_PRIORITY. See pipelines/slim/review_pr.dot.
  gate_er [
    type="gate_er",
    label="/er Evidence Review",
    backend_priority="codex,minimax,agy",
    prefer_adversarial="true",
    timeout=600
  ]

  // /web-advice fail-open advisory node (min_diff_lines="20" per slim lane policy)
  web_advice [
    type="web_advice",
    label="/web-advice (fail-open)",
    prompt="@prompts/web_advice.txt",
    backend="claude",
    explicit_claude_lane="true",
    requires_claude_config="true",
    timeout=900,
    min_diff_lines="20",
    transport="auto",
    decision="continue",
    fail_open="true",
    description="Multi-model browser review (gemini/grok/chatgpt/perplexity) via real authenticated browser sessions. FAIL-OPEN: never blocks. Signal goes to CXDB + PR comment."
  ]

  fix [
    type="codergen",
    label="Fix & Iterate",
    class="fix",
    prompt="@prompts/slim/fix.md",
    max_retries=2,
    max_visits="3",
    no_progress_max="2"
  ]

  start -> explore_in
  explore_out -> research
  research -> plan
  plan -> implement
  implement -> test

  test -> review [condition="outcome=success"]
  test -> fix [condition="outcome!=success"]

  review -> holdout [condition="outcome=success"]
  review -> fix [condition="outcome!=success"]

  holdout -> gate_es [condition="outcome=success"]
  holdout -> fix [condition="outcome!=success"]
  gate_es -> gate_er [condition="outcome=success"]
  gate_es -> fix [condition="outcome!=success"]

  gate_er -> web_advice [condition="outcome=success"]
  gate_er -> fix [condition="outcome!=success"]

  // Fail-open heart: single unconditional edge to exit.
  web_advice -> exit

  fix -> test
}
