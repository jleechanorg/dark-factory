// PR gates with the code-standards review decomposed into parallel
// single-lane gates.
//
// Why: /code-standards is an ORCHESTRATOR slash command — it instructs the
// agent to fan out independent ZFC / ZFC-leveling / RCF sub-reviews.
// Single-subprocess reviewer backends (codex exec) cannot spawn subagents,
// so they ingest every lane's skill text serially and hit the gate timeout
// before emitting any verdict (observed 3/3 on 2026-06-11, 1500s budget).
// Here the GRAPH owns the fan-out: each lane is its own gate_slash node
// running one small slash command, so any backend finishes within budget.
//
// Join policy is wait_all: a code-standards FAIL in any lane fails the gate
// (same semantics as the monolithic /code-standards verdict).
//
// Lane commands must exist in the target repo's .claude/commands/.
// For worldarchitect.ai: /zfc, /zfclevel, /thermo all exist.
// Adjust the command attrs per repo.

digraph pr_gates_split_cs {
    graph [
        goal="PR validation: sealed holdouts + evidence gates + split code-standards lanes."
        label="PR Gates (split CS)"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    holdout  [type="holdout_eval", label="Behavioral Holdouts",     timeout=600]
    gate_es  [type="gate_es",      label="/es Evidence Standards",  timeout=1500]
    gate_er  [type="gate_er",      label="/er Evidence Review",     timeout=1500]

    cs_fanout [type="parallel", shape=component, label="CS fan-out\n(3 lanes)"]

    gate_zfc      [type="gate_slash", command="zfc",
                   label="/zfc lane",      timeout=900]
    gate_zfclevel [type="gate_slash", command="zfclevel",
                   label="/zfclevel lane", timeout=900]
    gate_thermo   [type="gate_slash", command="thermo",
                   label="/thermo lane",   timeout=900]

    cs_join [type="join", shape=tripleoctagon, policy="wait_all",
             label="CS join\n(all lanes pass)"]

    start -> holdout
    holdout -> gate_es [condition="outcome=success"]
    holdout -> exit    [condition="outcome!=success"]

    gate_es -> gate_er [condition="outcome=success"]
    gate_es -> exit    [condition="outcome!=success"]

    gate_er -> cs_fanout [condition="outcome=success"]
    gate_er -> exit      [condition="outcome!=success"]

    cs_fanout -> gate_zfc
    cs_fanout -> gate_zfclevel
    cs_fanout -> gate_thermo
    gate_zfc      -> cs_join
    gate_zfclevel -> cs_join
    gate_thermo   -> cs_join

    cs_join -> exit
}
