digraph pr_gates {
    graph [
        goal="PR validation: sealed holdouts + 3 adversarial gates."
        level5="true"
        label="PR Gates"
        skip_explore="true"
        skip_plan="true"
        skip_implement="true"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    // Holdout-always policy: PR diffs run the sealed behavioral holdouts
    // first — evidence gates grade the diff's story, holdouts grade its
    // behavior. Feature comes from --feature / ctx.state["feature"].
    holdout         [type="holdout_eval",        label="Behavioral Holdouts",          feature="${state.feature}", timeout=600]
    gate_skeptic [
        type="gate_skeptic",
        label="Skeptic (inverted-incentive review)",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        timeout=600
    ]
    adversarial_reviewer [
        type="parallel_reviewer",
        label="Adversarial reviewer (primary + shadow Codex)",
        review_contract="cold-review-v1",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        receipt_required="true",
        timeout=600
    ]
    gate_es [
        type="gate_es",
        label="/es Evidence Standards",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]
    gate_er [
        type="gate_er",
        label="/er Evidence Review",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]
    gate_cs [
        type="gate_code_standards",
        label="/code_standards (ZFC + leveling + RCF)",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]

    // /web-advice fail-open advisory node
    web_advice [
        type="web_advice",
        label="/web-advice (fail-open)",
        prompt="@prompts/web_advice.txt",
        backend="claude",
        timeout=900,
        min_diff_lines="5",
        transport="auto",
        decision="continue",
        fail_open="true",
        description="Multi-model browser review (gemini/grok/chatgpt/perplexity) via real authenticated browser sessions. FAIL-OPEN: never blocks. Signal goes to CXDB + PR comment."
    ]

    // Bounded fix loop: any reviewer verdict other than success routes here
    // so the PR lane can iterate on the diff rather than terminating on a
    // first failure (per factory-evolve G2 fix-loop contract).
    fix [
        type="codergen",
        label="Fix & Iterate",
        class="fix",
        prompt="@prompts/slim/fix.md",
        max_visits="3",
        timeout=600
    ]

    // dark-factory#828: `fix` must only fire on an actionable finding
    // (outcome=failure — a REAL reviewer rejection). A gate that could not
    // produce a verdict at all (a null/unparseable verdict — normalized to
    // outcome=error, NOT failure, see runner/handler_verdict.py) or hit an
    // infra problem (outcome=error) has nothing for `fix` to act on;
    // routing either there let the coder improvise destructively with a
    // live PR checked out (real incident, 2026-08-30 — this exact
    // pipeline, PR #9583). outcome=error routes straight to exit instead —
    // same "stop, don't act" contract as web_advice below.
    start -> holdout
    holdout -> gate_skeptic [condition="outcome=success"]
    holdout -> fix         [condition="outcome!=success"]

    gate_skeptic -> adversarial_reviewer [condition="outcome=success"]
    gate_skeptic -> fix                  [condition="outcome=failure"]
    gate_skeptic -> exit                 [condition="outcome=error"]

    adversarial_reviewer -> gate_es [condition="outcome=success"]
    adversarial_reviewer -> fix     [condition="outcome=failure"]
    adversarial_reviewer -> exit    [condition="outcome=error"]

    gate_es -> gate_er [condition="outcome=success"]
    gate_es -> fix     [condition="outcome=failure"]
    gate_es -> exit    [condition="outcome=error"]

    gate_er -> gate_cs [condition="outcome=success"]
    gate_er -> fix     [condition="outcome=failure"]
    gate_er -> exit    [condition="outcome=error"]

    gate_cs -> web_advice [condition="outcome=success"]
    gate_cs -> fix        [condition="outcome=failure"]
    gate_cs -> exit       [condition="outcome=error"]

    // Fail-open heart: single unconditional edge to exit.
    web_advice -> exit
    fix -> holdout
}
