digraph gates {
    graph [
        goal="Full validation: holdout + Phase 5 N-shadow panel + /es + /code_standards."
        level5="true"
        label="Gates"
        skip_explore="true"
        skip_plan="true"
        skip_implement="true"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    holdout         [type="holdout_eval",        label="Holdout Eval", feature="hello", timeout=600]
    gate_es [
        type="gate_es",
        label="/es Evidence Standards",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]
    gate_cs [
        type="gate_code_standards",
        label="/code_standards (ZFC + leveling + RCF)",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]

    // ─── qw5: Phase 5 N-shadow fan-out (Beads: jleechan-qw5) ────────────────
    // Pilot scope: collapse the prior holdout → gate_skeptic → adversarial_reviewer
    // → gate_es → gate_er → gate_cs chain into
    //   holdout → review_parallel_phase5 → gate_es → gate_cs
    // where review_parallel_phase5 fans out ONE primary + THREE Codex shadow
    // reviewers against a single combined prompt (skeptic + adversarial + /er
    // roles). The runner applies the conservative coalesce: any error → error,
    // any fail/partial/warn → failure, all-pass only → success.
    //
    // NOTE: the prior gate_skeptic / adversarial_reviewer / gate_er node
    // DEFINITIONS are kept in this file's sibling graphs (slim/ etc.) for any
    // pipeline that still references them. They were removed here because the
    // runner enforces "no unreachable nodes from start" (parser.parse raises).
    review_parallel_phase5 [
        type="parallel_reviewer",
        label="Phase 5 panel (skeptic + adversarial + /er — 1 primary + 3 shadows)",
        prompt="@prompts/slim/review.md",
        backend_priority="minimax,agy,codex,claude-sonnet",
        prefer_adversarial="true",
        n_shadows="3",
        gate_strict="true",
        timeout=600
    ]

    // Bounded fix loop: any reviewer verdict other than success routes here
    // so the run can iterate on the artifact rather than terminating on a
    // first failure (per factory-evolve G2 fix-loop contract).
    fix [
        type="codergen",
        label="Fix & Iterate",
        class="fix",
        prompt="@prompts/slim/fix.md",
        max_visits="3",
        timeout=600
    ]

    start -> holdout
    holdout -> review_parallel_phase5 [condition="outcome=success"]
    holdout -> fix                    [condition="outcome!=success"]

    review_parallel_phase5 -> gate_es [condition="outcome=success"]
    review_parallel_phase5 -> fix     [condition="outcome!=success"]

    gate_es -> gate_cs [condition="outcome=success"]
    gate_es -> fix     [condition="outcome!=success"]

    gate_cs -> exit
    fix -> holdout
}
