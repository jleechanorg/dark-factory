digraph gates {
    graph [
        goal="Full validation: holdout + 3 adversarial gates."
        level5="true"
        label="Gates"
        skip_explore="true"
        skip_plan="true"
        skip_implement="true"
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    holdout         [type="holdout_eval",        label="Holdout Eval", feature="hello", timeout=600]
    gate_skeptic [
        type="gate_skeptic",
        label="Skeptic (inverted-incentive review)",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        max_retries=2,
        timeout=600
    ]
    adversarial_reviewer [
        type="parallel_reviewer",
        label="Adversarial reviewer (primary + N shadows, density-enforced)",
        review_contract="cold-review-v1",
        prompt="@prompts/slim/review_phase5_shadow.md",
        backend_priority="minimax,agy,codex,claude-sonnet",
        prefer_adversarial="true",
        n_shadows="3",
        gate_strict="true",
        receipt_required="true",
        timeout=600
    ]
    gate_es [
        type="gate_es",
        label="/es Evidence Standards",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]
    gate_er [
        type="gate_er",
        label="/er Evidence Review",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]
    gate_cs [
        type="gate_code_standards",
        label="/code_standards (ZFC + leveling + RCF)",
        backend_priority="codex,minimax,agy,claude-sonnet",
        prefer_adversarial="true",
        gate_strict="true",
        timeout=600
    ]

    // /web-advice fail-open advisory node
    web_advice [
        type="web_advice",
        label="/web-advice (fail-open)",
        prompt="@prompts/web_advice.txt",
        backend="claude",
        timeout=900,
        min_diff_lines="5",
        transport="auto",
        decision="continue",
        fail_open="true",
        description="Multi-model browser review (gemini/grok/chatgpt/perplexity) via real authenticated browser sessions. FAIL-OPEN: never blocks. Signal goes to CXDB + PR comment."
    ]

    // Bounded fix loop: any reviewer verdict other than success routes here
    // so the run can iterate on the artifact rather than terminating on a
    // first failure (per factory-evolve G2 fix-loop contract).
    fix [
        type="codergen",
        label="Fix & Iterate",
        class="fix",
        prompt="@prompts/slim/fix.md",
        max_visits="3",
        timeout=600
    ]

    start -> holdout
    holdout -> gate_skeptic [condition="outcome=success"]
    holdout -> fix         [condition="outcome!=success"]

    // Issue #827 Defect 1: a null/unparseable verdict is scored as its own
    // `inconclusive` outcome (see runner/handler_universal_prompts.py
    // _gate_skeptic), distinct from a real `failure` rejection. It is
    // retried up to `max_retries` times above (in-node, no extra graph
    // steps); if still inconclusive after that, there is no finding for
    // `fix` to act on, so this routes straight to `exit` instead — the
    // `_exit` handler (runner/handler_core.py) propagates a non-success
    // predecessor outcome rather than masking it as a pass, so
    // `final_outcome` never reads as a false "success"/"pass".
    //
    // The condition below matches on the `no_verdict` metadata flag, NOT
    // on `outcome=inconclusive` directly: the engine's
    // `_run_single_node` normalizes every Result's `.outcome` through
    // `_classify_outcome` before any edge condition sees it, and that
    // classifier buckets "inconclusive" into "failure" (same bucket as a
    // real rejection) — so an `outcome`-keyed condition could never tell
    // the two apart at routing time. `metadata` is untouched by that
    // normalization, which is also why this is not the `outcome!=success`
    // shape the G2 graph audit forbids on reviewer->exit edges: this
    // reroutes a non-actionable "no verdict produced" event, not a real
    // failure verdict, off the fix loop.
    gate_skeptic -> adversarial_reviewer [condition="outcome=success"]
    gate_skeptic -> exit                 [condition="no_verdict=true"]
    gate_skeptic -> fix                  [condition="outcome!=success and no_verdict!=true"]

    adversarial_reviewer -> gate_es [condition="outcome=success"]
    adversarial_reviewer -> fix     [condition="outcome!=success"]

    gate_es -> gate_er [condition="outcome=success"]
    gate_es -> fix     [condition="outcome!=success"]

    gate_er -> gate_cs [condition="outcome=success"]
    gate_er -> fix     [condition="outcome!=success"]

    gate_cs -> web_advice [condition="outcome=success"]

    // Fail-open heart: single unconditional edge to exit.
    web_advice -> exit
    fix -> holdout
}
