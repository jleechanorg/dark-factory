// G1 violator: a codergen exists, but no reviewer node is wired on any
// path from the codergen to exit. The graph reaches exit un-reviewed.
digraph g1_violator {
    graph [goal="G1 violator: no reviewer wired"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    coder [
        type="codergen",
        label="Coder",
        prompt="@prompts/slim/implement.md"
    ]

    start -> coder
    coder -> exit
}