// G2 violator: a reviewer is wired, but its failure branch routes
// directly to exit (no fix loop). The graph records the verdict but
// does not block on it.
digraph g2_violator {
    graph [goal="G2 violator: reviewer failure -> exit"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    coder [
        type="codergen",
        label="Coder",
        prompt="@prompts/slim/implement.md"
    ]
    reviewer [
        type="gate_er",
        label="Reviewer",
        timeout=600
    ]

    start    -> coder
    coder    -> reviewer
    reviewer -> exit [condition="outcome=success"]
    reviewer -> exit [condition="outcome!=success"]
}