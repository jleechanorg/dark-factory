# Database
*.db
*.db-journal
*.db-shm
*.db-wal
# fsqlite multi-process namespace sidecars (timestamped on every br invocation,
# not source — see daemon/src/fsqlite gate requirement that they be 0600)
beads.db-fsqlite-ns-gate
beads.db-fsqlite-ns-use
**/beads.db-fsqlite-ns-gate
**/beads.db-fsqlite-ns-use

# Lock files
*.lock
.write.lock

# Temporary
last-touched
*.tmp

# Local history backups
.br_history/

# Sync state (local-only, per-machine)
.sync.lock
sync_base.jsonl

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
sync-state.json

# jtg8-r4: adoption-probe cache (runtime data, not source)
adoption_probe_cache.json

# Worktree redirect file
redirect

# bv (beads viewer) lock file
.bv.lock
